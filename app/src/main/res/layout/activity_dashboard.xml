<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0a0a1a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◆ SET PIN"
        android:textSize="22sp"
        android:textColor="#ff0055"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti PIN untuk fitur Ransom"
        android:textSize="13sp"
        android:textColor="#888"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Masukkan PIN baru"
        android:inputType="numberPassword"
        android:background="@drawable/input_gold"
        android:textColor="#fff"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSavePin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="◆ SIMPAN PIN"
        android:background="@drawable/btn_gold"
        android:textColor="#fff"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#888"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCurrentPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN saat ini: 123456"
        android:textSize="12sp"
        android:textColor="#555"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◆ NEMESIS v1.0"
        android:textSize="10sp"
        android:textColor="#222"
        android:fontFamily="monospace"
        android:layout_marginTop="20dp" />

</LinearLayout>

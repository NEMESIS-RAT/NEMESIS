<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◆"
            android:textSize="28sp"
            android:textColor="#ff0055"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" NEMESIS"
            android:textSize="22sp"
            android:textColor="#ff0055"
            android:fontFamily="monospace"
            android:shadowColor="#ff0055"
            android:shadowRadius="20" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0"
            android:textSize="12sp"
            android:textColor="#666"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Grid Tombol -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:padding="8dp">

        <Button
            android:id="@+id/btnLock"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:text="🔒\nLock"
            android:background="@drawable/btn_red"
            android:textColor="#fff"
            android:textSize="12sp"
            android:padding="4dp"
            android:gravity="center"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnRansom"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:text="💰\nRansom"
            android:background="@drawable/btn_gold"
            android:textColor="#fff"
            android:textSize="12sp"
            android:padding="4dp"
            android:gravity="center"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnAppBuild"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:text="📦\nBuild"
            android:background="@drawable/btn_red"
            android:textColor="#fff"
            android:textSize="12sp"
            android:padding="4dp"
            android:gravity="center"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:text="⚙️\nSet PIN"
            android:background="@drawable/btn_gold"
            android:textColor="#fff"
            android:textSize="12sp"
            android:padding="4dp"
            android:gravity="center"
            android:layout_margin="4dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1" />

    </GridLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◆ NEMESIS v1.0"
        android:textSize="10sp"
        android:textColor="#222"
        android:fontFamily="monospace"
        android:layout_gravity="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
